{
"model":{
	"id":"treelikelihood",
	"type": "treelikelihood",
	"sse": true,
	"sitepattern":{
		"id":"patterns",
		"type":"sitepattern",		
		"datatype":"nucleotide",
		"alignment":{
			"id": "seqs",
			"type": "alignment",
			"file":"tiny.fa"
		}
	},
	"sitemodel":{
		"id": "sitemodel",
		"type": "sitemodel",
		"substitutionmodel":{
			"id":"sm",
			"type":"substitutionmodel",
			"model":"jc69",
			"datatype":"nucleotide",
			"frequencies":{
				"id":"freqs",
				"type":"Simplex",
				"x":[0.25,0.25,0.25,0.25] 
			}
		}	
	},
	"tree":{
		"id":"tree",
		"type":"tree",
		"branch_lengths":{
			"id": "tree.distances",
			"type": "parameter",
			"dimension": 17,
			"x": 0.1 
		},
		"initializer":{
			"id":"nj",
			"algorithm":"nj",
			"model":"jc69",
			"sitepattern": "&patterns"
		}
	}
},
"physher":[
	{
		"id":"metaopt",
		"type":"optimizer",
		"algorithm":"meta",
		"precision":0.001,
		"iterations": 10000,
		"model":"@treelikelihood",
		"list":[
			{				
				"id":"optbl",
				"type":"optimizer",
				"algorithm":"serial",
				"model":"@treelikelihood",
				"treelikelihood": "@treelikelihood"
			}
		]
	},
	{
		"id": "log",
		"type": "logger",
		"tree": true,
		"models": "@tree"
	}
]
}